# Copy to .env for local runs:  cp .env.example .env
# .env is git-ignored — never commit real credentials.
# In Kubernetes these same values are supplied by a Secret (see k8s/secret.example.yaml).

# Path the training/serving code reads its YAML config from
TRAINING_CONFIG_PATH=/app/configs/training_config.yaml

# Fast-demo overrides — keep training runs short for Docker/K8s demonstrations.
# Leave unset to honour the full values in configs/training_config.yaml.
SUBSET_FRACTION=0.1
MAX_EPOCHS=2

# Serving
MODEL_CHECKPOINT_PATH=/app/checkpoints/classifier_v1.pt
SERVE_PORT=8080

# Example of a genuine secret consumed via env (placeholder value only)
MODEL_REGISTRY_TOKEN=replace-me-locally
